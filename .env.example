# Copy to .env on the server (/opt/pulse/.env). Never commit .env.

# Postgres / Redis (compose builds DATABASE_URL and REDIS_URL from these)
POSTGRES_USER=pulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pulse

# Caddy: ":80" for local; the dashboard hostname on the core VPS for automatic TLS (needs the DNS A record first)
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
# Public base URL, used for links in alert messages and the heartbeat URLs the CLI prints
PUBLIC_URL=

# Auth (required by the web service): openssl rand -base64 32
AUTH_SECRET=

# Alerts (Phase 4). Everything alert-related is off unless ALERTS_ENABLED=true: no Telegram polling, no email,
# no daily digest, no watchdog ping. Incidents are still recorded. Heartbeat push and probe ingest stay on.
ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Email fallback, used only when a Telegram delivery fails. Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Second vantage ingest: openssl rand -hex 32. The same value goes into the probe's .env on HostVDS.
HMAC_INGEST_SECRET=

# Watchdog: Pulse GETs this URL every minute while healthy, e.g. a Healthchecks.io ping URL
WATCHDOG_URL=

# Set false to disable the check scheduler (e.g. local dev)
SCHEDULER_ENABLED=true
