# Copy to .env on the server. Never commit .env.

# Postgres / Redis (compose builds DATABASE_URL and REDIS_URL from these)
POSTGRES_USER=pulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pulse

# Caddy: ":80" for local; real hostname on the core VPS for automatic TLS
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# Auth (Phase 3): openssl rand -base64 32
AUTH_SECRET=

# Alerts (Phase 4)
ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Second vantage ingest (Phase 4): openssl rand -hex 32
HMAC_INGEST_SECRET=

# Watchdog ping URL, e.g. Healthchecks.io (Phase 4)
WATCHDOG_URL=

# Phase 1: set false to disable the check scheduler (e.g. local dev)
SCHEDULER_ENABLED=true
